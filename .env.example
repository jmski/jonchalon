# All variables below are optional — the app builds and runs with none of
# them set. Schema lives in lib/env.ts.

# Sentry — error monitoring. Leave unset to run without Sentry locally.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Google Analytics — consent-gated, off until the cookie banner is accepted.
NEXT_PUBLIC_GA_ID=
